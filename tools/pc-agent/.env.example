# pc-agent configuration

# API authentication token (REQUIRED)
# Must match PC_AGENT_TOKEN in Pi's smart-home-prod/.env
# Generate new: [System.Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes(32))
PC_AGENT_TOKEN=PjXKHDjRjH4gQ+OVBpuvdXAVOLMgYSLWObf7iNQpZfI=

# Valheim Docker container name
VALHEIM_CONTAINER=valheim-server

# Valheim server installation directory
# Contains: .env, server_data/worlds_local/, server_data/logs/
VALHEIM_SERVER_DIR=E:\valheim-server

# Directory containing power profile scripts
SCRIPTS_DIR=C:\Users\acmls\Documents\Scripts
