# ============================================
# SMART HOME - Environment Variables
# ============================================

# -------------------- MELCloud --------------------
# MELCloud credentials (REQUIRED)
# Get from your MELCloud account (Mitsubishi app)
MELCLOUD_EMAIL=your_email@example.com
MELCLOUD_PASSWORD=your_password_here

# Device IDs (REQUIRED)
# Get from MELCloud app or via API
MELCLOUD_DEVICE_ID=12345678
MELCLOUD_BUILDING_ID=87654321

# MELCloud API Configuration
# MELCLOUD_URL=https://app.melcloud.com
# MELCLOUD_TIMEOUT=30.0
# MELCLOUD_MAX_FAILURES=100
# MELCLOUD_APP_VERSION=1.32.1.0

# -------------------- AC Control --------------------
# Default target temperature (°C)
# TARGET_TEMPERATURE=26.0

# Hysteresis (°C)
# HYSTERESIS_ON=0.5      # Turn on AC when temp > target + 0.5°C
# HYSTERESIS_OFF=0.3     # Turn off AC when temp < target - 0.3°C

# AC temperature ranges (°C)
# MIN_SETPOINT_TEMP=19.0
# MAX_SETPOINT_TEMP=30.0

# Cooldown between off and next on (seconds)
# COOLDOWN_SECONDS=180   # 3 minutes

# Control loop interval (seconds)
# LOOP_INTERVAL=10

# Sensor timeout (seconds)
# SENSOR_TIMEOUT=3600    # 1 hour

# Maximum fan speed (0-5)
# FAN_SPEED_MAX=3

# -------------------- MQTT --------------------
# MQTT broker configuration
# MQTT_BROKER=mosquitto
# MQTT_PORT=1883
# MQTT_CONNECT_RETRIES=30
# MQTT_RETRY_DELAY=2
# MQTT_KEEPALIVE=60

# -------------------- Zigbee2MQTT --------------------
# Sensor discovery timeout (seconds)
# Z2M_DISCOVERY_TIMEOUT=10.0

# -------------------- History --------------------
# Maximum historical readings per sensor
# MAX_HISTORY_PER_SENSOR=200

# -------------------- Cleanup --------------------
# Old log cleanup interval (seconds)
# CLEANUP_INTERVAL_SECONDS=86400  # 24 hours

# Grace period before first cleanup (seconds)
# CLEANUP_GRACE_PERIOD=60

# Log retention (days)
# LOG_RETENTION_DAYS=3

# -------------------- API and Security --------------------
# Allowed CORS origins (comma-separated)
# Use "*" only in local development
# CORS_ORIGINS=http://localhost:8080,https://smart-home.local

# -------------------- Outdoor Temperature --------------------
# Cache TTL for outdoor temperature (seconds)
# OUTDOOR_CACHE_TTL=600  # 10 minutes

# Geographic location (Valdebernardo, Madrid by default)
# LOCATION_LATITUDE=40.396644
# LOCATION_LONGITUDE=-3.622511

# -------------------- Energy --------------------
# AC power by state (kW)
# AC_POWER_COOLING_MAX=2.5
# AC_POWER_COOLING_MID=1.75
# AC_POWER_MODULATING=1.25
# AC_POWER_FORCED_ON=2.5

# -------------------- OPTIONAL --------------------
# ESIOS API (REE - Red Eléctrica España) for PVPC prices
# Get free key at: https://www.esios.ree.es/es/pagina/api
# OPTIONAL: If not configured, uses mock price of €0.15/kWh
# ESIOS_API_KEY=your_api_key_here_optional

# ============================================
# CASITA SUEÑOS — Monitor inmobiliario
# ============================================

# ── Telegram ────────────────────────────────
# Crear bot en @BotFather → obtener token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID donde recibir alertas (tu chat personal o un grupo)
# Para obtenerlo: habla con @userinfobot en Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Apify (free tier $5/mes) ─────────────────
# Registro gratuito en https://apify.com → Settings → Integrations → API token
APIFY_API_TOKEN=your_apify_api_token_here

# ── Gmail (alertas de Idealista) ─────────────
# Tu dirección de Gmail donde recibes las alertas de Idealista
GMAIL_ADDRESS=your_email@gmail.com

# Rutas a los ficheros OAuth2 (generados con setup_gmail.py, una vez)
# Por defecto apuntan a /app/data dentro del contenedor
# GMAIL_CREDENTIALS_PATH=/app/data/gmail_credentials.json
# GMAIL_TOKEN_PATH=/app/data/gmail_token.json

# ── Base de datos y datos ────────────────────
# Directorio de datos persistentes (montado como volumen Docker)
# CASITA_DATA_DIR=/app/data
# CASITA_DB_PATH=/app/data/casita.db
# APIFY_USAGE_PATH=/app/data/apify_usage.json
# ============================================
# AUTHENTICATION — Centralised JWT session auth
# ============================================
# Secret key for signing JWT tokens (REQUIRED)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=replace_with_generated_secret_hex_32_chars_minimum

# Path to the nginx .htpasswd file mounted inside the backend container
# Default matches the Docker volume mount — only change if you move the file
# AUTH_HTPASSWD_PATH=/etc/nginx/.htpasswd

# SQLite database for trusted-device requests
# Stored in the same persistent volume as other backend data
# AUTH_DB_PATH=/app/data/auth.db

# Session token lifetime (seconds)
# AUTH_SESSION_TTL=86400      # 24 hours (standard session)
# AUTH_TRUSTED_TTL=31536000   # 365 days (trusted device, after admin approval)

# SMTP credentials for trusted-device approval emails
# Use a Gmail App Password (not your account password):
#   Google Account → Security → 2-Step Verification → App passwords
AUTH_SMTP_USER=acmlsn@gmail.com
AUTH_SMTP_PASSWORD=replace_with_gmail_app_password

# Public base URL of the platform (used to build approve/reject links in emails)
AUTH_BASE_URL=https://raspberrypi.local
