# ============================================
# SMART HOME - Variables de Entorno
# ============================================

# -------------------- MELCloud --------------------
# Credenciales MELCloud (OBLIGATORIAS)
# Obtener de tu cuenta MELCloud (app Mitsubishi)
MELCLOUD_EMAIL=tu_email@ejemplo.com
MELCLOUD_PASSWORD=tu_password_aqui

# IDs del dispositivo (OBLIGATORIOS)
# Obtener desde la app MELCloud o mediante la API
MELCLOUD_DEVICE_ID=12345678
MELCLOUD_BUILDING_ID=87654321

# Configuración API MELCloud
# MELCLOUD_URL=https://app.melcloud.com
# MELCLOUD_TIMEOUT=30.0
# MELCLOUD_MAX_FAILURES=100
# MELCLOUD_APP_VERSION=1.32.1.0

# -------------------- Control AC --------------------
# Temperatura objetivo por defecto (°C)
# TARGET_TEMPERATURE=26.0

# Histéresis (°C)
# HYSTERESIS_ON=0.5      # Encender AC cuando temp > objetivo + 0.5°C
# HYSTERESIS_OFF=0.3     # Apagar AC cuando temp < objetivo - 0.3°C

# Rangos de temperatura del AC (°C)
# MIN_SETPOINT_TEMP=19.0
# MAX_SETPOINT_TEMP=30.0

# Cooldown entre apagado y siguiente encendido (segundos)
# COOLDOWN_SECONDS=180   # 3 minutos

# Intervalo del loop de control (segundos)
# LOOP_INTERVAL=10

# Timeout de sensores (segundos)
# SENSOR_TIMEOUT=3600    # 1 hora

# Velocidad máxima del ventilador (0-5)
# FAN_SPEED_MAX=3

# -------------------- MQTT --------------------
# Configuración del broker MQTT
# MQTT_BROKER=mosquitto
# MQTT_PORT=1883
# MQTT_CONNECT_RETRIES=30
# MQTT_RETRY_DELAY=2
# MQTT_KEEPALIVE=60

# -------------------- Zigbee2MQTT --------------------
# Timeout para descubrimiento de sensores (segundos)
# Z2M_DISCOVERY_TIMEOUT=10.0

# -------------------- Historial --------------------
# Máximo de lecturas históricas por sensor
# MAX_HISTORY_PER_SENSOR=200

# -------------------- Limpieza --------------------
# Intervalo de limpieza de logs antiguos (segundos)
# CLEANUP_INTERVAL_SECONDS=86400  # 24 horas

# Tiempo de espera antes de primera limpieza (segundos)
# CLEANUP_GRACE_PERIOD=60

# Retención de logs (días)
# LOG_RETENTION_DAYS=3

# -------------------- API y Seguridad --------------------
# CORS origins permitidos (separados por comas)
# Usar "*" solo en desarrollo local
# CORS_ORIGINS=http://localhost:8080,https://smart-home.local

# -------------------- Temperatura Exterior --------------------
# Cache TTL para temperatura exterior (segundos)
# OUTDOOR_CACHE_TTL=600  # 10 minutos

# Ubicación geográfica (Valdebernardo, Madrid por defecto)
# LOCATION_LATITUDE=40.396644
# LOCATION_LONGITUDE=-3.622511

# -------------------- Energía --------------------
# Potencias del AC por estado (kW)
# AC_POWER_COOLING_MAX=2.5
# AC_POWER_COOLING_MID=1.75
# AC_POWER_MODULATING=1.25
# AC_POWER_FORCED_ON=2.5

# -------------------- OPCIONAL --------------------
# API ESIOS (REE - Red Eléctrica España) para precios PVPC
# Obtener key gratuita en: https://www.esios.ree.es/es/pagina/api
# OPCIONAL: Si no se configura, usa precio mock de 0.15€/kWh
# ESIOS_API_KEY=tu_api_key_aqui_opcional
